<brls:Box
        width="100%"
        height="100%"
        axis="column"
        justifyContent="spaceBetween"
        alignItems="center">

        <brls:Box
                id="video/osd/top/box"
                width="100%"
                height="80"
                backgroundStartColor="#000000CC"
                backgroundEndColor="#00000000"
                background="vertical_linear">

                <!-- Back button on Android to return to channel list -->
                <brls:Box
                        id="video/osd/back"
                        hideClickAnimation="true"
                        alignItems="center"
                        justifyContent="center"
                        marginLeft="10"
                        height="60"
                        width="60">
                        <SVGImage
                                id="video/osd/back/icon"
                                focusable="true"
                                focusUp="video/osd/back/icon"
                                focusLeft="video/osd/back/icon"
                                focusRight="video/osd/setting/icon"
                                focusDown="video/osd/lock/box"
                                hideHighlightBackground="true"
                                highlightCornerRadius="30"
                                height="30"
                                width="30"
                                SVG="@res/svg/arrow-left.svg" />
                </brls:Box>

                <brls:Label
                        id="video/osd/title"
                        height="100%"
                        marginLeft="10"
                        marginRight="120"
                        grow="1"
                        singleLine="true"
                        textColor="#FFFFFF" />

                <brls:Box
                        wireframe="false"
                        id="video/osd/setting"
                        hideClickAnimation="true"
                        positionType="absolute"
                        positionRight="10"
                        positionTop="10"
                        alignItems="center"
                        justifyContent="center"
                        height="60"
                        width="60">
                        <brls:Box
                                id="video/osd/setting/icon"
                                focusable="true"
                                focusUp="video/osd/setting/icon"
                                focusLeft="video/osd/setting/icon"
                                focusRight="video/osd/setting/icon"
                                focusDown="video/osd/lock/box"
                                hideHighlightBackground="true"
                                highlightCornerRadius="30"
                                height="30"
                                width="30" />
                </brls:Box>
        </brls:Box>

        <brls:Box
                axis="column"
                alignItems="center"
                justifyContent="center"
                visibility="gone"
                cornerRadius="4"
                width="100"
                height="100"
                backgroundColor="#303030A0"
                id="video/osd/center/box2">
                <SVGImage
                        id="video/osd/center/icon2"
                        height="30"
                        width="30"
                        marginBottom="20" />
                <brls:Label
                        id="video/osd/center/label2"
                        textColor="#FFFFFF"
                        fontSize="24"
                        height="16"
                        horizontalAlign="center"
                        verticalAlign="center" />
        </brls:Box>

        <brls:Box
                axis="column"
                alignItems="center"
                id="video/osd/center/box">
                <brls:ProgressSpinner
                        id="video/osd/loading"
                        width="100"
                        height="100" />
                <brls:Label
                        id="video/osd/center/label"
                        visibility="invisible"
                        cornerRadius="4"
                        backgroundColor="#303030A0"
                        textColor="#FFFFFF"
                        fontSize="16"
                        height="16"
                        horizontalAlign="center"
                        verticalAlign="center" />
        </brls:Box>

        <brls:Box
                id="video/osd/bottom/box"
                width="100%"
                height="120"
                alignItems="center"
                axis="row"
                background="vertical_linear">
                <brls:Box
                        id="video/osd/toggle"
                        wireframe="false"
                        focusable="true"
                        focusUp="video/osd/setting/icon"
                        focusLeft="video/osd/toggle"
                        focusRight="video/osd/icon/box"
                        hideHighlightBackground="true"
                        highlightCornerRadius="100"
                        hideClickAnimation="true"
                        alignItems="center"
                        justifyContent="center"
                        marginLeft="20"
                        marginBottom="20"
                        height="100"
                        width="100">
                        <SVGImage
                                id="video/osd/toggle/icon"
                                wireframe="false"
                                height="100"
                                width="100"
                                SVG="@res/svg/bpx-svg-sprite-play.svg" />
                </brls:Box>
                <brls:Box
                        width="auto"
                        grow="1"
                        height="130"
                        axis="column">
                        <!-- VideoProgressSlider disabled on Android to avoid heap corruption -->
                        <brls:Box
                                focusable="true"
                                id="video/osd/bottom/progress/android"
                                focusUp="video/osd/lock/box"
                                focusRight="video/osd/bottom/progress/android"
                                width="100%"
                                height="50"
                                marginTop="10"
                                grow="1" />
                        <brls:Box
                                width="100%"
                                height="80"
                                alignItems="center"
                                grow="1">
                                <brls:Label
                                        wireframe="false"
                                        horizontalAlign="right"
                                        id="video/left/status"
                                        height="100%"
                                        width="100"
                                        textColor="#FFFFFF"
                                        text="00:00" />
                                <brls:Label
                                        id="video/center/status"
                                        horizontalAlign="center"
                                        height="100%"
                                        textColor="#FFFFFF"
                                        text="/" />
                                <brls:Label
                                        wireframe="false"
                                        horizontalAlign="left"
                                        id="video/right/status"
                                        height="100%"
                                        width="100"
                                        textColor="#FFFFFF"
                                        text="00:00" />
                                <brls:Box
                                        id="video/osd/icon/box"
                                        positionType="absolute"
                                        positionRight="20">

                                        <brls:Box
                                                id="video/osd/danmaku/box/volume"
                                                hideClickAnimation="true"
                                                alignItems="center"
                                                justifyContent="center"
                                                height="60"
                                                width="60">
                                                <SVGImage
                                                        id="video/osd/danmaku/volume/icon"
                                                        focusable="true"
                                                        focusUp="video/osd/lock/box"
                                                        focusDown="video/osd/danmaku/volume/icon"
                                                        hideHighlightBackground="true"
                                                        highlightCornerRadius="30"
                                                        wireframe="false"
                                                        height="30"
                                                        width="30"
                                                        SVG="@res/svg/bpx-svg-sprite-volume.svg" />
                                        </brls:Box>

                                        <brls:Box
                                                id="video/osd/favorite"
                                                hideClickAnimation="true"
                                                alignItems="center"
                                                justifyContent="center"
                                                height="60"
                                                width="60">
                                                <SVGImage
                                                        id="video/osd/favorite/icon"
                                                        wireframe="false"
                                                        focusable="true"
                                                        focusUp="video/osd/lock/box"
                                                        focusDown="video/osd/favorite/icon"
                                                        hideHighlightBackground="true"
                                                        highlightCornerRadius="30"
                                                        height="30"
                                                        width="30"
                                                        SVG="@res/svg/ico-favorites.svg" />
                                        </brls:Box>

                                        <!-- Fullscreen button repurposed as Back button on Android -->
                                        <brls:Box
                                                id="video/osd/fullscreen"
                                                hideClickAnimation="true"
                                                alignItems="center"
                                                justifyContent="center"
                                                height="60"
                                                width="60">
                                                <SVGImage
                                                        id="video/osd/fullscreen/icon"
                                                        wireframe="false"
                                                        focusable="true"
                                                        focusUp="video/osd/lock/box"
                                                        focusDown="video/osd/fullscreen/icon"
                                                        focusRight="video/osd/fullscreen/icon"
                                                        hideHighlightBackground="true"
                                                        highlightCornerRadius="30"
                                                        height="30"
                                                        width="30"
                                                        SVG="@res/svg/bpx-svg-sprite-fullscreen-off.svg" />
                                        </brls:Box>
                                </brls:Box>
                        </brls:Box>
                        <brls:Box
                                cornerRadius="4"
                                backgroundColor="@theme/brls/backdrop"
                                detachedX="30"
                                detachedY="-20"
                                visibility="gone"
                                height="32"
                                id="video/osd/hint/box">
                                <brls:Label
                                        id="video/osd/hint/label"
                                        marginLeft="10"
                                        marginRight="10"
                                        marginTop="4"
                                        marginBottom="4"
                                        maxWidth="600"
                                        textColor="#FFFFFF" />
                        </brls:Box>
                </brls:Box>
        </brls:Box>

        <!-- VideoProfile disabled on Android -->

        <brls:Box
                width="50"
                height="50"
                alignItems="center"
                hideHighlightBackground="true"
                highlightCornerRadius="10"
                backgroundColor="#303030A0"
                focusable="true"
                focusUp="video/osd/setting/icon"
                focusDown="video/osd/icon/box"
                focusRight="video/osd/lock/box"
                focusLeft="video/osd/lock/box"
                cornerRadius="8"
                positionTop="45%"
                positionRight="20"
                positionType="absolute"
                id="video/osd/lock/box">
                <SVGImage
                        id="video/osd/lock/icon"
                        detachedX="13"
                        detachedY="13"
                        height="24"
                        width="24"
                        SVG="@res/svg/player-unlock.svg" />
        </brls:Box>

</brls:Box>
